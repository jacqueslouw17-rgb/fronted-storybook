{
  "$description": "Fronted Design System colour & core tokens. Source: fronted.com (Webflow). W3C Design Tokens format. primitive = raw ramps (one family per hue), semantic = role aliases. Components reference semantic only.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" },
      "neutral": {
        "50": { "$type": "color", "$value": "#FAFAFB" }, "100": { "$type": "color", "$value": "#F7F7F7" },
        "200": { "$type": "color", "$value": "#ECECEE" }, "300": { "$type": "color", "$value": "#E2E2E2" },
        "400": { "$type": "color", "$value": "#CACBCF" }, "500": { "$type": "color", "$value": "#9A9CA3" },
        "600": { "$type": "color", "$value": "#6B7280" }, "700": { "$type": "color", "$value": "#4B4D54" },
        "800": { "$type": "color", "$value": "#333333" }, "900": { "$type": "color", "$value": "#1E1E1E" },
        "950": { "$type": "color", "$value": "#0F1011" }
      },
      "yellow": {
        "50": { "$type": "color", "$value": "#FFFCF2" }, "100": { "$type": "color", "$value": "#FFF7E0" },
        "200": { "$type": "color", "$value": "#FFF2D7" }, "300": { "$type": "color", "$value": "#FEECA6" },
        "400": { "$type": "color", "$value": "#FBDE7E" }, "500": { "$type": "color", "$value": "#F2C94C" },
        "600": { "$type": "color", "$value": "#D9A92E" }, "700": { "$type": "color", "$value": "#B08520" },
        "800": { "$type": "color", "$value": "#855F18" }, "900": { "$type": "color", "$value": "#5C4011" }
      },
      "teal": {
        "50": { "$type": "color", "$value": "#ECF4F4" }, "100": { "$type": "color", "$value": "#CFE5E5" },
        "200": { "$type": "color", "$value": "#A6CDCE" }, "300": { "$type": "color", "$value": "#74ABAE" },
        "400": { "$type": "color", "$value": "#45898D" }, "500": { "$type": "color", "$value": "#226A6E" },
        "600": { "$type": "color", "$value": "#134E51" }, "700": { "$type": "color", "$value": "#0C3E41" },
        "800": { "$type": "color", "$value": "#083638" }, "900": { "$type": "color", "$value": "#063033" },
        "950": { "$type": "color", "$value": "#041F21" }
      },
      "green": {
        "50": { "$type": "color", "$value": "#ECFDF5" }, "100": { "$type": "color", "$value": "#D1FAE5" },
        "200": { "$type": "color", "$value": "#A7F3D0" }, "300": { "$type": "color", "$value": "#6EE7B7" },
        "400": { "$type": "color", "$value": "#34D399" }, "500": { "$type": "color", "$value": "#10B981" },
        "600": { "$type": "color", "$value": "#059669" }, "700": { "$type": "color", "$value": "#047857" },
        "800": { "$type": "color", "$value": "#006147" }, "900": { "$type": "color", "$value": "#064E3B" }
      },
      "rose": {
        "50": { "$type": "color", "$value": "#FEF2F2" }, "100": { "$type": "color", "$value": "#FCE4E3" },
        "200": { "$type": "color", "$value": "#F9CBCA" }, "300": { "$type": "color", "$value": "#F3A6A4" },
        "400": { "$type": "color", "$value": "#EA7C79" }, "500": { "$type": "color", "$value": "#DC5450" },
        "600": { "$type": "color", "$value": "#C23B37" }, "700": { "$type": "color", "$value": "#9B2D2A" },
        "800": { "$type": "color", "$value": "#7A2422" }, "900": { "$type": "color", "$value": "#5A1B19" }
      }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": ["Clash Display", "Inter", "Arial", "sans-serif"] },
      "sans": { "$type": "fontFamily", "$value": ["Inter", "Arial", "Helvetica", "sans-serif"] }
    },
    "fontSize": {
      "2xs": { "$type": "dimension", "$value": "11px" }, "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" }, "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" }, "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" }, "3xl": { "$type": "dimension", "$value": "28px" },
      "4xl": { "$type": "dimension", "$value": "36px" }, "5xl": { "$type": "dimension", "$value": "48px" },
      "6xl": { "$type": "dimension", "$value": "60px" }
    },
    "lineHeight": {
      "16": { "$type": "dimension", "$value": "16px" }, "20": { "$type": "dimension", "$value": "20px" },
      "24": { "$type": "dimension", "$value": "24px" }, "28": { "$type": "dimension", "$value": "28px" },
      "32": { "$type": "dimension", "$value": "32px" }, "36": { "$type": "dimension", "$value": "36px" },
      "44": { "$type": "dimension", "$value": "44px" }, "56": { "$type": "dimension", "$value": "56px" },
      "64": { "$type": "dimension", "$value": "64px" }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": 400 }, "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }, "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "letterSpacing": {
      "tight": { "$type": "dimension", "$value": "-0.02em" }, "snug": { "$type": "dimension", "$value": "-0.01em" },
      "normal": { "$type": "dimension", "$value": "0" }, "wide": { "$type": "dimension", "$value": "0.08em" }
    },
    "space": {
      "$description": "4px base grid. Index = px ÷ 4 (0-5 = 2px micro step).",
      "0": { "$type": "dimension", "$value": "0" }, "0-5": { "$type": "dimension", "$value": "2px" },
      "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" }, "6": { "$type": "dimension", "$value": "24px" },
      "7": { "$type": "dimension", "$value": "28px" }, "8": { "$type": "dimension", "$value": "32px" },
      "9": { "$type": "dimension", "$value": "36px" }, "10": { "$type": "dimension", "$value": "40px" },
      "11": { "$type": "dimension", "$value": "44px" }, "12": { "$type": "dimension", "$value": "48px" },
      "14": { "$type": "dimension", "$value": "56px" }, "16": { "$type": "dimension", "$value": "64px" },
      "20": { "$type": "dimension", "$value": "80px" }, "24": { "$type": "dimension", "$value": "96px" },
      "32": { "$type": "dimension", "$value": "128px" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0" }, "xs": { "$type": "dimension", "$value": "2px" },
      "sm": { "$type": "dimension", "$value": "4px" }, "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "12px" }, "xl": { "$type": "dimension", "$value": "16px" },
      "2xl": { "$type": "dimension", "$value": "20px" }, "pill": { "$type": "dimension", "$value": "9999px" }
    }
  },
  "semantic": {
    "color": {
      "heading": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
      "text": { "$type": "color", "$value": "{primitive.color.neutral.900}", "$description": "Primary body — 16.1:1 (AAA)." },
      "text-strong": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
      "text-muted": { "$type": "color", "$value": "{primitive.color.neutral.600}", "$description": "Secondary / subtext — 4.83:1 (AA)." },
      "text-disabled": { "$type": "color", "$value": "{primitive.color.neutral.400}", "$description": "Disabled only — exempt from contrast." },
      "text-inverse": { "$type": "color", "$value": "{primitive.color.white}" },
      "bg": { "$type": "color", "$value": "{primitive.color.neutral.50}" },
      "surface": { "$type": "color", "$value": "{primitive.color.white}" },
      "surface-sunken": { "$type": "color", "$value": "{primitive.color.neutral.100}" },
      "surface-accent": { "$type": "color", "$value": "{primitive.color.yellow.50}", "$description": "Soft brand-tinted surface — accented section headers / banners." },
      "surface-accent-hover": { "$type": "color", "$value": "{primitive.color.yellow.100}", "$description": "Hover for accent surface." },
      "border": { "$type": "color", "$value": "{primitive.color.neutral.300}" },
      "border-strong": { "$type": "color", "$value": "{primitive.color.neutral.400}" },
      "focus-ring": { "$type": "color", "$value": "{primitive.color.teal.500}" }
    },
    "type": {
      "display": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.6xl}", "lineHeight": "{primitive.lineHeight.64}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.tight}" } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.5xl}", "lineHeight": "{primitive.lineHeight.56}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.tight}" } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.4xl}", "lineHeight": "{primitive.lineHeight.44}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.snug}" } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.3xl}", "lineHeight": "{primitive.lineHeight.36}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.snug}" } },
      "h4": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.2xl}", "lineHeight": "{primitive.lineHeight.32}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "h5": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.xl}", "lineHeight": "{primitive.lineHeight.28}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "h6": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.display}", "fontSize": "{primitive.fontSize.base}", "lineHeight": "{primitive.lineHeight.24}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "body-lg": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.sans}", "fontSize": "{primitive.fontSize.lg}", "lineHeight": "{primitive.lineHeight.28}", "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.sans}", "fontSize": "{primitive.fontSize.base}", "lineHeight": "{primitive.lineHeight.24}", "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "body-sm": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.sans}", "fontSize": "{primitive.fontSize.sm}", "lineHeight": "{primitive.lineHeight.20}", "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "label": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.sans}", "fontSize": "{primitive.fontSize.sm}", "lineHeight": "{primitive.lineHeight.20}", "fontWeight": "{primitive.fontWeight.medium}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "caption": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.sans}", "fontSize": "{primitive.fontSize.xs}", "lineHeight": "{primitive.lineHeight.16}", "fontWeight": "{primitive.fontWeight.regular}", "letterSpacing": "{primitive.letterSpacing.normal}" } },
      "overline": { "$type": "typography", "$value": { "fontFamily": "{primitive.font.sans}", "fontSize": "{primitive.fontSize.xs}", "lineHeight": "{primitive.lineHeight.16}", "fontWeight": "{primitive.fontWeight.semibold}", "letterSpacing": "{primitive.letterSpacing.wide}", "textTransform": "uppercase" } }
    },
    "action": {
      "primary-bg": { "$type": "color", "$value": "{primitive.color.yellow.300}" },
      "primary-bg-hover": { "$type": "color", "$value": "{primitive.color.yellow.400}" },
      "primary-bg-active": { "$type": "color", "$value": "{primitive.color.yellow.500}" },
      "primary-fg": { "$type": "color", "$value": "{primitive.color.black}" },
      "primary-radius": { "$type": "dimension", "$value": "9999px" },
      "secondary-bg": { "$type": "color", "$value": "transparent" },
      "secondary-bg-hover": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
      "secondary-bg-active": { "$type": "color", "$value": "{primitive.color.neutral.950}" },
      "secondary-fg": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
      "secondary-fg-hover": { "$type": "color", "$value": "{primitive.color.white}" },
      "secondary-border": { "$type": "color", "$value": "transparent" }
    },
    "feedback": {
      "success": { "bg": "{primitive.color.green.50}", "fg": "{primitive.color.green.700}", "border": "{primitive.color.green.200}", "solid": "{primitive.color.green.600}" },
      "warning": { "bg": "{primitive.color.yellow.100}", "fg": "{primitive.color.yellow.800}", "border": "{primitive.color.yellow.300}", "solid": "{primitive.color.yellow.500}" },
      "danger":  { "bg": "{primitive.color.rose.50}", "fg": "{primitive.color.rose.600}", "border": "{primitive.color.rose.200}", "solid": "{primitive.color.rose.600}" },
      "info":    { "bg": "{primitive.color.teal.50}", "fg": "{primitive.color.teal.700}", "border": "{primitive.color.teal.200}", "solid": "{primitive.color.teal.600}" }
    },
    "radius": {
      "button": { "$type": "dimension", "$value": "{primitive.radius.pill}" },
      "chip":   { "$type": "dimension", "$value": "{primitive.radius.pill}" },
      "input":  { "$type": "dimension", "$value": "{primitive.radius.md}" },
      "card":   { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "sheet":  { "$type": "dimension", "$value": "{primitive.radius.xl}" }
    }
  }
}
